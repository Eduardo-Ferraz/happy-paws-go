        <mxCell id="t15" parent="1" style="shape=note;whiteSpace=wrap;html=0;size=14;fillColor=#FFFFCC;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" value="Duas hierarquias paralelas (BAUER; KING, 2007): à esquerda as interfaces,
