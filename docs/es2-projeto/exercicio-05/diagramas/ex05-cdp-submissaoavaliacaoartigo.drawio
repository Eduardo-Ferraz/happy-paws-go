        <mxCell id="t9" parent="1" style="shape=note;whiteSpace=wrap;html=0;size=14;fillColor=#FFFFCC;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" value="RI01 — um artigo submetido a um evento só pode versar sobre temas
